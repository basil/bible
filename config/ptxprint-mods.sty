% Inherit the font family and numeral features from layout.ini throughout.
% Set running furniture in small caps. smcp converts lowercase and c2sc
% converts capitals, keeping book names entirely in small caps.
% PTXprint's zfooter+h style stack makes
% footers inherit this header style without a duplicate override.
\Marker h
\ztexFontFeatures +[smcp] +[c2sc]

% Set Greek quotations in GFS Didot; ptx2pdf's Galatia SIL is not installed.
\Marker wg
\FontName GFS Didot

% Use OLEBFont's Erewhon-derived designed superscript figures for verse numbers. The figures
% are already small and raised, so turn off the stylesheet's scaling, and the
% raise that \Superscript - leaves behind from usfm_sb.sty's \Superscript.
\Marker v
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% Match publishing alternate verse numbers to the main verse-number style.
\Marker vp
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% Indent a line that goes on with a verse well past the line that opens it,
% as PTXprint's WSG and aArp samples do; ptx2pdf.sty sets them 0.15 unit
% apart. A line too long for the page wraps to the shared left margin.
\Marker q1
\LeftMargin 0.6

\Marker q2
\LeftMargin 0.6
\FirstLineIndent -0.225

% Set added words in ordinary roman type, as docs/edition.md describes, not
% the bold italic of usfm_sb.sty.
\Marker add
\Bold -
\Italic -

% A title is set in italic throughout, its added words too.
\Marker add+d
\Italic

% A title (a Psalm's superscription) is followed by a blank line in the
% generated USFM, which sets it one line from its poem, as a stanza break
% does; usfm_sb.sty's space after it would add to that.
\Marker d
\SpaceAfter 0

% Set a note's lemma, the words it glosses, in roman type followed by a colon;
% only another rendering of them (fqa) is italic. usfm_sb.sty sets fq italic.
\Marker fq
\Italic -

% Match note origin numbers to the body verse figures: OLEBFont's Erewhon-derived designed
% superscripts at the same nominal 9 pt (12 stylesheet units). FontSize
% clears the inherited note-relative FontScale; disable extra scaling and
% raising so the glyphs keep their designed size and position. Keep them roman.
\Marker fr
\FontSize 12
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt
\Bold -

% Cross-reference origin numbers should match footnote origin numbers.
\Marker xo
\FontSize 12
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt
\Bold -

% Narrow marginal notes need a ragged right edge to avoid stretched words.
% Keep PTXprint’s ordinary note size and leading. Zero SpaceBeside removes
% its implicit extra 1 pt, leaving the 6 mm gap specified in mods.tex.
\Marker f
\Justification Left
\SpaceBeside 0

% Match cross references to the footnotes sharing the inner-margin column.
\Marker x
\Justification Left
\SpaceBeside 0

% The notes set below the text and the Appendix notes use the native
% extended-footnote class, which stays below the text, justified like it.
% Keep the ordinary footnote size and leading of ptx2pdf.sty; ef otherwise
% inherits the larger USFM default size.
\Marker ef
\FontSize 10
\LineSpacing 0.833

% The verses a note of Brenton's Appendix supplies carry their numbers as the
% text carries a supplied passage's.
\Marker fv
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% The numbering tables have fixed columns, so that every book's table lines
% up the same. PTXprint uses tc's SpaceBefore as a fixed column width in
% twelfths of the text width. The King James side is wide enough for "Song
% of the Three Holy Children (Apocrypha)" on one line, with a little space
% before the edition's side, which holds its widest heading.
\Marker cat:reference|tc1
\SpaceBefore 7

\Marker cat:reference|tc2
\SpaceBefore 5

% A kathisma heading stands above the psalms it holds, so it is set larger
% than their chapter labels. The stasis rule's spacing in ptxprint-mods.tex
% is measured against the label's size.
\Marker ms1
\FontSize 18

\Marker cl
\FontSize 14

% Set chapter numbers in roman, not the bold of usfm_sb.sty.
\Marker c
\Bold -

% Ordinary stasis divisions use the standard semantic division paragraph.
\Marker sd2
\Justification Center
% The before hook supplies fixed TeX-point spacing around the rule.
\SpaceBefore 0
\SpaceAfter 0

% The Seventeenth Kathisma names its stases within Psalm 118.
% Section paragraphs stay with the following verse in PTXprint.
\Marker s2
\Bold -

\Marker s3
\Bold -
\Justification Center
