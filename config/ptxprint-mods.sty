% Inherit the font family and numeral features from layout.ini throughout.
% Greek quotations (wg) are set in the Greek face the image installed beside
% OLEBFont, which project.py names at the end of this file.

% Set the running heads in small caps. smcp converts lowercase and c2sc
% converts capitals, keeping book names entirely in small caps.
\Marker h
\ztexFontFeatures +[smcp] +[c2sc]

% Book titles and section headings are set in the regular face's
% designed small capitals, their initials included, as the running heads are.
\Marker mt1
\Bold -
\ztexFontFeatures +[smcp] +[c2sc]

\Marker s1
\Bold -
\ztexFontFeatures +[smcp] +[c2sc]

% The footer, which PTXprint's zfooter+h style stack makes inherit the head's
% features, holds the page number alone: set it in the ordinary oldstyle
% figures, not the small-cap lining figures that Valkyrie's c2sc selects.
\Marker zfooter
\ztexFontFeatures -[smcp] -[c2sc]

% Use OLEBFont's designed superior figures for verse numbers: Erewhon's with
% Utopia, Valkyrie's own with Valkyrie, and in both the superior letters and
% colon of a mixed label (35a, 30:1) that sups selects too. The figures
% are already small and raised, so turn off the stylesheet's scaling, and the
% raise that \Superscript - leaves behind from usfm_sb.sty's \Superscript.
\Marker v
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% Match publishing alternate verse numbers to the main verse-number style.
\Marker vp
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% Restore usfm_sb.sty's poetry geometry: relative to the ordinary prose
% indent (.125 unit), level-1 and level-2 poetic lines open at 2X and 3X;
% both wrap at 6X. Keep PTXprint's alignment and spacing.
\Marker q1
\LeftMargin 0.75
\FirstLineIndent -0.5

\Marker q2
\LeftMargin 0.75
\FirstLineIndent -0.375

% Set added words in ordinary roman type, as the introduction
% (content/introduction.sfm) describes, not
% the bold italic of usfm_sb.sty.
\Marker add
\Bold -
\Italic -

% A descriptive title is set in italic throughout, its added words too.
\Marker add+d
\Italic

% The Prologue names an introductory unit, in upright small capitals like
% the other structural headings, keeping its size and spacing.
\Marker imt1
\Bold -
\ztexFontFeatures +[smcp] +[c2sc]
\FontSize 12

% Keep native acrostic headings, centred in upright small caps. Their verse
% numbers print on the following poetic line through ptxprint-mods.tex.
% Separate each label from the preceding poetry, keeping it with what follows.
\Marker qa
\Italic -
\ztexFontFeatures +[smcp] +[c2sc]
\Justification Center
\SpaceBefore 4

% Set a note's lemma, the words it glosses, in roman type followed by a colon;
% only another rendering of them (fqa) is italic. usfm_sb.sty sets fq italic.
\Marker fq
\Italic -

% Match note origin numbers to the body verse figures: OLEBFont's designed
% superscripts at the same nominal 9 pt (12 stylesheet units). FontSize
% clears the inherited note-relative FontScale; disable extra scaling and
% raising so the glyphs keep their designed size and position. Keep them roman.
\Marker fr
\FontSize 12
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt
\Bold -

% Cross-reference origin numbers should match footnote origin numbers.
\Marker xo
\FontSize 12
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt
\Bold -

% Narrow marginal notes need a ragged right edge to avoid stretched words.
% Keep PTXprint’s ordinary note size and leading. Zero SpaceBeside removes
% its implicit extra 1 pt, leaving the 6 mm gap specified in mods.tex.
\Marker f
\Justification Left
\SpaceBeside 0

% Match cross references to the footnotes sharing the inner-margin column.
\Marker x
\Justification Left
\SpaceBeside 0

% The verses a note of Brenton's Appendix supplies carry their numbers as the
% text carries a supplied passage's.
\Marker fv
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% A kathisma heading stands above the psalms it holds, so it is set larger
% than their chapter labels.
\Marker ms1
\Bold -
\ztexFontFeatures +[smcp] +[c2sc]
\FontSize 18

% The chapter label and the chapter number take proportional lining figures,
% in roman, not the bold of usfm_sb.sty. The font name layout.ini gives
% embeds +onum=1, which a feature-list subtraction cannot undo, so the two
% styles select their own figures. project.py names the image's chapter
% face for c (newpx with Valkyrie, OLEBFont with Utopia); cl keeps the body
% family.
\Marker cl
\FontName OLEBFont
\Bold -
\ztexFontFeatures +[smcp] +[c2sc] +[lnum] +[pnum]
\FontSize 14
% A following descriptive title supplies its own upper space.
\SpaceAfter 0

\Marker c
\Bold -
\ztexFontFeatures +[lnum] +[pnum]

% The Seventeenth Kathisma names its stases within Psalm 118, as major
% section headings under its kathisma heading.
\Marker ms2
\Bold -
\ztexFontFeatures +[smcp] +[c2sc]

% Its Middle is an italic liturgical note, separated from the preceding
% poetry and kept close to the line it introduces.
\Marker lit
\Bold -
\Italic
\Justification Center
\SpaceBefore 4

% Every sidebar is a colophon, which spans the text's full width. PTXprint
% sizes a sidebar at \esb, with its default 1 pt padding at either side,
% before \cat names the category, and measures it again from that narrower
% width, so the padding is cleared here, not under the category.
\Marker esb
\BoxPadding 0

% A terminal subscription, retained from the KJV or supplied from Boyd, is
% separate paratext, printed where it occurs.
\Marker cat:colophon|esb
\Position h
\Border None

% Its notice is set flush left, without a paragraph's first-line indent.
\Marker cat:colophon|p
\FirstLineIndent 0

\Marker periph:pubdata|pc
\SpaceBefore 12

% A testament's divider sets the lines beneath its title flush left: its
% translation's title page, then the edition's own.
\Marker periph:x-old-testament|mt2
\Justification Left

\Marker periph:x-old-testament|mt3
\Justification Left

\Marker periph:x-new-testament|mt2
\Justification Left

\Marker periph:x-new-testament|mt3
\Justification Left
