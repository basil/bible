\Marker wg
\FontName GFS Didot

% Use Erewhon's designed superscript figures for verse numbers.
\Marker v
\FontName erewhon
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% Match publishing alternate verse numbers to the main verse-number style.
\Marker vp
\FontName erewhon
\ztexFontFeatures +[sups]
\Superscript -
\Raise 0pt

% Keep added words in regular roman type.
\Marker add
\Bold -
\Italic -
