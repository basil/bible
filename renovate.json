{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "abandonments:recommended",
    ":configMigration",
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "Upstream projects pinned by commit in the Dockerfile",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_URL=(?<packageName>\\S+)\\s+ARG \\w+_(?:TAG|BRANCH)=(?<currentValue>\\S+)\\s+ARG \\w+_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "ptxprint"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "prBodyNotes": [
        "Follow the PTXprint checklist under \"Updating dependencies\" in CONTRIBUTING.md."
      ]
    }
  ]
}
