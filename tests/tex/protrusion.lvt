% Compare the plain-XeTeX adapter in config/ptxprint-mods.tex with the
% installed stock microtype package, for every present glyph in the edition's
% font families, faces, and representative sizes. Run through `make test-tex`.
\documentclass{article}
\input{regression-test}
\usepackage{fontspec}
\setmainfont{Utopia}
\newfontfamily\didot{GFS Didot}
\newfontfamily\ezra{Ezra SIL}
\usepackage{microtype}
\makeatletter
% The PTXprint stub selects a supplied native font handle. Avoid LaTeX's
% selection hooks here so microtype cannot repopulate the codes under test.
\def\s@tfont#1#2{#1\relax}
\def\uselanguage#1{}
\input{ptxprint-mods.tex}
\font\OtherFont="Utopia Italic" at 11pt
\newcount\glyph
\newcount\mismatches
% #1 labels the font in the log; #2 selects it.
\def\CheckFont#1#2{%
  \begingroup
  #2\relax
  \expandafter\let\expandafter\TargetFont\the\font
  % Save stock codes, then reset them so the adapter must populate them.
  % Skip glyph 0 (.notdef): we intentionally leave missing glyphs untouched.
  \glyph=1
  \loop\ifnum\glyph<\XeTeXcountglyphs\font
    \expandafter\edef\csname left:\the\glyph\endcsname{\the\lpcode\font\glyph}%
    \expandafter\edef\csname right:\the\glyph\endcsname{\the\rpcode\font\glyph}%
    \lpcode\font\glyph=0 \rpcode\font\glyph=0
    \advance\glyph by1
  \repeat
  \global\mismatches=0
  % Initialize from a different font, then leave the initialization group.
  \OtherFont
  \begingroup
    \s@tfont{\TargetFont}{}%
    \AssertFontCodes{initialized}%
  \endgroup
  % The group restored OtherFont. Reselect the cached target and verify that
  % both font selection and protrusion codes survive that group boundary.
  \s@tfont{\TargetFont}{}%
  \AssertFontCodes{reselected}%
  \TYPE{#1: \the\mismatches\space mismatches}%
  \endgroup
}
% #1 names the check stage in failure messages.
\def\AssertFontCodes#1{%
  \expandafter\let\expandafter\SelectedFont\the\font
  \ifx\SelectedFont\TargetFont\else
    \TYPE{#1: Protrusion wrapper did not select the requested font}%
  \fi
  \glyph=1
  \loop\ifnum\glyph<\XeTeXcountglyphs\font
    \ifnum\lpcode\font\glyph=\csname left:\the\glyph\endcsname\relax\else
      \global\advance\mismatches by1
      \TYPE{#1: MISMATCH left glyph \the\glyph: \the\lpcode\font\glyph\space expected \csname left:\the\glyph\endcsname}%
    \fi
    \ifnum\rpcode\font\glyph=\csname right:\the\glyph\endcsname\relax\else
      \global\advance\mismatches by1
      \TYPE{#1: MISMATCH right glyph \the\glyph: \the\rpcode\font\glyph\space expected \csname right:\the\glyph\endcsname}%
    \fi
    \advance\glyph by1
  \repeat
}
\makeatother
\begin{document}
% Load every face and size before the logged region so that only the
% comparison results reach the test log.
\setbox0=\hbox{%
  {\normalfont}{\itshape}{\bfseries}{\bfseries\itshape}%
  {\fontsize{9.5}{12}\selectfont}{\fontsize{48}{50}\selectfont}%
  {\didot}{\ezra}}
\START
\CheckFont{Utopia regular}{\normalfont}
\CheckFont{Utopia italic}{\itshape}
\CheckFont{Utopia bold}{\bfseries}
\CheckFont{Utopia bold italic}{\bfseries\itshape}
\CheckFont{Utopia 9.5pt}{\fontsize{9.5}{12}\selectfont}
\CheckFont{Utopia 48pt}{\fontsize{48}{50}\selectfont}
\CheckFont{GFS Didot}{\didot}
\CheckFont{Ezra SIL}{\ezra}
\END
